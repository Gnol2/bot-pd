# Token bot Discord
DISCORD_TOKEN=

# Nội dung file JSON service account Google (dán nguyên 1 dòng)
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# Trợ lý luật /ai (module ai) — Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Tuỳ chọn cho /ai (bỏ trống = dùng mặc định trong ngoặc)
SYNC_SECONDS=68                # Đọc lại luật từ Sheet mỗi N giây (60, tối thiểu 30)
USER_COOLDOWN_SECONDS=5        # Mỗi người phải chờ N giây giữa 2 câu hỏi (3)
# CONVERSATION_TTL_MINUTES=15  # Nhớ ngữ cảnh hội thoại trong N phút (15)
# MAX_CANDIDATE_RULES=12       # Số luật gợi ý ưu tiên gửi kèm (12, từ 4 đến 20)
# GOOGLE_SHEET_NAME=luatpd           # Tab luật PD (luatpd)
# GOOGLE_CITY_RULES_SHEET=tricklobicam # Tab luật thành phố (tricklobicam)
